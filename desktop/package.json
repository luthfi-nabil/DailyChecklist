{
  "name": "langkah-kecil-desktop",
  "version": "0.3.1",
  "description": "Lifolio - Desktop Daily Checklist & Personal Life OS",
  "author": "Lifolio",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.langkahkecil.desktop",
    "productName": "Lifolio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  }
}
